<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Conversor NFS-e XML → XLSX</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
  :root { --bg:#f5f7f6; --card:#fff; --fg:#1d2a26; --muted:#5f6f69; --line:#d5ddd9; --accent:#1f7a5a; }
  @media (prefers-color-scheme: dark) { :root { --bg:#141a18; --card:#1c2421; --fg:#e4ece8; --muted:#9aaba4; --line:#2e3a36; --accent:#4cc39a; color-scheme:dark; } }
  body { margin:0; background:var(--bg); color:var(--fg); font:15px/1.5 system-ui, sans-serif; padding:32px 16px; }
  main { max-width:640px; margin:0 auto; display:grid; gap:16px; }
  h1 { margin:0; font-size:1.4rem; }
  p { margin:0; color:var(--muted); }
  #drop { border:2px dashed var(--line); border-radius:10px; background:var(--card); padding:40px 16px; text-align:center; cursor:pointer; }
  #drop.over { border-color:var(--accent); }
  button { background:var(--accent); color:#fff; border:0; border-radius:8px; padding:12px 18px; font-size:15px; cursor:pointer; }
  button:disabled { opacity:.4; cursor:default; }
  button:focus-visible, #drop:focus-visible { outline:3px solid var(--accent); outline-offset:2px; }
  #status { font-variant-numeric:tabular-nums; }
</style>
</head>
<body>
<main>
  <h1>Conversor NFS-e XML → XLSX</h1>
  <p>Os arquivos são lidos só no seu navegador. Nada é enviado para a internet.</p>
  <label id="drop" tabindex="0">
    Arraste os XMLs aqui ou clique para escolher
    <input id="files" type="file" accept=".xml" multiple hidden>
  </label>
  <div id="status"></div>
  <div><button id="baixar" disabled>Baixar notas.xlsx</button></div>
</main>
<script>
const drop = document.getElementById('drop'), input = document.getElementById('files');
const status = document.getElementById('status'), btn = document.getElementById('baixar');
let linhas = [];

// Achata o XML: cada campo folha vira uma coluna (ex.: infNFSe_valores_vLiq)
function achatar(el, pref, d) {
  for (const f of el.children) {
    const chave = pref + f.localName;
    if (f.children.length) achatar(f, chave + '_', d);
    else d[chave] = f.textContent;
  }
  return d;
}

async function ler(files) {
  linhas = []; const erros = [];
  for (const f of files) {
    const doc = new DOMParser().parseFromString(await f.text(), 'application/xml');
    if (doc.querySelector('parsererror')) { erros.push(f.name); continue; }
    linhas.push(achatar(doc.documentElement, '', { arquivo: f.name }));
  }
  status.textContent = `${linhas.length} nota(s) lida(s)` + (erros.length ? ` · com erro: ${erros.join(', ')}` : '');
  btn.disabled = !linhas.length;
}

input.onchange = () => ler(input.files);
drop.ondragover = e => { e.preventDefault(); drop.classList.add('over'); };
drop.ondragleave = () => drop.classList.remove('over');
drop.ondrop = e => { e.preventDefault(); drop.classList.remove('over'); ler(e.dataTransfer.files); };
btn.onclick = () => {
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(linhas), 'Notas');
  XLSX.writeFile(wb, 'notas.xlsx');
};
</script>
</body>
</html>
